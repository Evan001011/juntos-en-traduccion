# Optional — Google Chat space incoming webhook for booking + safety alerts.
# Create one in Google Chat: space > Apps & integrations > Webhooks.
GOOGLE_CHAT_WEBHOOK=

# Optional — label shown in the UI for the meeting provider.
# Sessions fall back to meet.google.com/new when no link is pasted.
GOOGLE_MEET_BASE=https://meet.google.com/new

# School timezone used for all scheduling + calendar exports.
NEXT_PUBLIC_SCHOOL_TZ=America/New_York
